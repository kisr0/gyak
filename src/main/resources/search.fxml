<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.SearchController"
      spacing="20"
      prefWidth="850"
      prefHeight="550"
      style="-fx-background-color: #172438;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Behajtott járművek keresése"
           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="searchField"
               promptText="Keresés rendszám vagy nemzetiség alapján (pl. ABC-123)..."
               prefHeight="40"
               style="-fx-font-size: 14px; -fx-background-radius: 8;"/>

    <TableView fx:id="parkingTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="plateColumn" text="Rendszám" prefWidth="120"/>
            <TableColumn fx:id="nationalityColumn" text="Nemzetiség" prefWidth="90"/>
            <TableColumn fx:id="colorColumn" text="Szín" prefWidth="80"/>
            <TableColumn fx:id="checkInColumn" text="Behajtás" prefWidth="140"/>
            <TableColumn fx:id="checkOutColumn" text="Kihajtás" prefWidth="140"/>
            <TableColumn fx:id="durationColumn" text="Bent töltött idő" prefWidth="130"/>
            <TableColumn fx:id="statusColumn" text="Státusz" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button text="Kijelölt jármű kihajtatása"
                onAction="#handleCheckOut"
                prefHeight="38"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Bezárás"
                onAction="#closeWindow"
                prefWidth="120"
                prefHeight="38"
                style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>