<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.EntryController"
      alignment="CENTER"
      spacing="20"
      prefWidth="500"
      prefHeight="530"
      style="-fx-background-color: #172438;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="colorGroup"/>
    </fx:define>

    <Label text="Új behajtás rögzítése"
           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Rendszám -->
    <VBox spacing="6" maxWidth="320">
        <Label text="Rendszám:"
               style="-fx-text-fill: #CBD5E1; -fx-font-size: 14px;"/>
        <TextField fx:id="licensePlateField"
                   promptText="pl. ABC-123"
                   prefHeight="40"
                   style="-fx-font-size: 16px; -fx-background-radius: 6;"/>
    </VBox>

    <!-- Nemzetiség -->
    <VBox spacing="6" maxWidth="320">
        <Label text="Nemzetiség:"
               style="-fx-text-fill: #CBD5E1; -fx-font-size: 14px;"/>
        <TextField fx:id="nationalityField"
                   promptText="pl. H"
                   prefHeight="40"
                   style="-fx-font-size: 16px; -fx-background-radius: 6;"/>
    </VBox>

    <!-- Rendszám színe -->
    <VBox spacing="10" maxWidth="320">
        <Label text="Rendszám színe:"
               style="-fx-text-fill: #CBD5E1; -fx-font-size: 14px;"/>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <RadioButton fx:id="whiteRadio"
                         text="Fehér"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <RadioButton fx:id="yellowRadio"
                         text="Sárga"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: #FFD700; -fx-font-size: 14px;"/>
            <RadioButton fx:id="greenRadio"
                         text="Zöld"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: #32CD32; -fx-font-size: 14px;"/>
        </HBox>
    </VBox>

    <!-- Gombok -->
    <HBox spacing="15" alignment="CENTER">
        <VBox.margin>
            <Insets top="15"/>
        </VBox.margin>
        <Button text="Mentés"
                onAction="#saveEntry"
                prefWidth="140"
                prefHeight="42"
                style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="Mégse"
                onAction="#cancel"
                prefWidth="140"
                prefHeight="42"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>